# Copie para .env e preencha com credenciais do painel Mercado Pago.
# Nunca publique o arquivo .env nem coloque o Access Token no JavaScript do navegador.
PORT=3000
NODE_ENV=development
# URL publica HTTPS da loja. Em producao use o dominio real; para testes locais use HTTPS via tunnel.
BASE_URL=https://seu-dominio.com.br
MP_ACCESS_TOKEN=APP_USR-COLOQUE_SEU_ACCESS_TOKEN_AQUI
MP_WEBHOOK_SECRET=COLOQUE_A_ASSINATURA_SECRETA_DOS_WEBHOOKS_AQUI
# Opcional: caminho absoluto para o banco SQLite.
# DATABASE_PATH=./data/orders.sqlite
